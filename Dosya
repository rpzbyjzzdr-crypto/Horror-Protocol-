 scene.add(monster);

 const lamp=new THREE.PointLight(0xffcccc,2,12);
 lamp.position.set(0,3,-10);
 scene.add(lamp);

 setupControls();
 animate();
}

function setupControls(){
 function bind(id,key){
  const el=document.getElementById(id);
  el.addEventListener('pointerdown',e=>{
   e.preventDefault();
   el.setPointerCapture(e.pointerId);
   keys[key]=true;
  });
  function stop(){keys[key]=false;}
  ['pointerup','pointercancel','lostpointercapture'].forEach(evt=>{
   el.addEventListener(evt,stop);
  });
 }
 bind('up','w');
 bind('down','s');
 bind('left','a');
 bind('right','d');

 window.addEventListener('keydown',e=>{
  keys[e.key.toLowerCase()]=true;
 });
 window.addEventListener('keyup',e=>{
  keys[e.key.toLowerCase()]=false;
 });

 const area=document.getElementById('lookArea');

 area.addEventListener('pointerdown',e=>{
  lookPointer=e.pointerId;
  lastX=e.clientX;
  lastY=e.clientY;
  area.setPointerCapture(e.pointerId);
 });

 area.addEventListener('pointermove',e=>{
  if(e.pointerId!==lookPointer)return;
  const dx=e.clientX-lastX;
  const dy=e.clientY-lastY;
  lastX=e.clientX;
  lastY=e.clientY;
  yaw-=dx*0.006;
  pitch-=dy*0.004;
  pitch=THREE.MathUtils.clamp(pitch,-0.8,0.8);
 });

 function endLook(e){
  if(e.pointerId===lookPointer)lookPointer=null;
 }
 area.addEventListener('pointerup',endLook);
 area.addEventListener('pointercancel',endLook);
}

function animate(){
 requestAnimationFrame(animate);
 if(!running||gameOver)return;

 const speed=0.075;
 let forward=0,side=0;

 if(keys.w||keys.arrowup)forward++;
 if(keys.s||keys.arrowdown)forward--;
 if(keys.a||keys.arrowleft)side--;
 if(keys.d||keys.arrowright)side++;

 if(forward||side){
  const length=Math.hypot(forward,side);
  forward/=length;
  side/=length;

  // Hareket artık kameranın baktığı yöne göre hesaplanıyor.
  const dx=-Math.sin(yaw)*forward+Math.cos(yaw)*side;
  const dz=-Math.cos(yaw)*forward-Math.sin(yaw)*side;

  player.position.x+=dx*speed;
  player.position.z+=dz*speed;

  player.rotation.y=Math.atan2(-dx,-dz);
 }

 player.position.x=THREE.MathUtils.clamp(player.position.x,-13,13);
 player.position.z=THREE.MathUtils.clamp(player.position.z,-13,13);

 // Kamera oyuncuyu takip eder
 const distance=5;
 const horizontal=Math.cos(pitch)*distance;
 camera.position.set(
  player.position.x+Math.sin(yaw)*horizontal,
  player.position.y+1.8+Math.sin(pitch)*distance,
  player.position.z+Math.cos(yaw)*horizontal
 );
 camera.lookAt(
  player.position.x,
  player.position.y+1.2,
  player.position.z
 );

 // Anahtar toplama
 keyObject.rotation.y+=0.03;
 if(!hasKey && player.position.distanceTo(keyObject.position)<1.3){
  hasKey=true;
  scene.remove(keyObject);
  document.getElementById('info').innerHTML=
   'GÖREV: Kaçış kapısına git<br>Anahtar: Bulundu!';
 }

 // Canavar oyuncuya yaklaşır
 const direction=new THREE.Vector3(
  player.position.x-monster.position.x,
  0,
  player.position.z-monster.position.z
 );
 const distanceToPlayer=direction.length();

 if(distanceToPlayer>1.2){
  direction.normalize();
  monster.position.x+=direction.x*0.025;
  monster.position.z+=direction.z*0.025;
  monster.rotation.y=Math.atan2(-direction.x,-direction.z);
 }else{
  gameOver=true;
  document.getElementById('info').innerHTML=
   'CANAVAR SENİ YAKALADI! Sayfayı yenileyip tekrar dene.';
 }

 // Kaçış kapısı
 const doorDistance=player.position.distanceTo(door.position);
 if(hasKey&&doorDistance<2){
  gameOver=true;
  document.getElementById('info').innerHTML=
   'BÖLÜM TAMAMLANDI! Hastaneden kaçtın!';
 }

 renderer.render(scene,camera);
}

window.addEventListener('resize',()=>{
 if(!camera||!renderer)return;
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});
</script>

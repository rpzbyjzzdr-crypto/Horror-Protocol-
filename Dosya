<script type="module">
import * as THREE from
'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

let scene,camera,renderer,player,flashlight,monster,keyObject,door;
let running=false,flashlightOn=true,hasKey=false,gameOver=false;
let keys={},yaw=0,pitch=0;
let lookPointer=null,lastX=0,lastY=0;

window.startGame=function(){
 document.getElementById('menu').style.display='none';
 document.getElementById('hud').style.display='block';
 if(!scene)init();
 running=true;
};

window.toggleLight=function(){
 flashlightOn=!flashlightOn;
 flashlight.visible=flashlightOn;
};

function init(){
 scene=new THREE.Scene();
 scene.background=new THREE.Color(0x080808);
 scene.fog=new THREE.Fog(0x080808,5,35);

 camera=new THREE.PerspectiveCamera(70,innerWidth/innerHeight,0.1,100);
 renderer=new THREE.WebGLRenderer({antialias:true});
 renderer.setSize(innerWidth,innerHeight);
 renderer.setPixelRatio(Math.min(devicePixelRatio,2));
 document.body.appendChild(renderer.domElement);

 scene.add(new THREE.AmbientLight(0xffffff,0.3));

 const floor=new THREE.Mesh(
  new THREE.PlaneGeometry(40,40),
  new THREE.MeshStandardMaterial({color:0x303030})
 );
 floor.rotation.x=-Math.PI/2;
 scene.add(floor);

 const wallMaterial=new THREE.MeshStandardMaterial({color:0x555555});

 function makeWall(x,y,z,w,h,d){
  const obj=new THREE.Mesh(
   new THREE.BoxGeometry(w,h,d),wallMaterial
  );
  obj.position.set(x,y,z);
  scene.add(obj);
 }

 makeWall(0,2,-15,30,4,1);
 makeWall(0,2,15,30,4,1);
 makeWall(-15,2,0,1,4,30);
 makeWall(15,2,0,1,4,30);

 for(let i=0;i<5;i++){
  makeWall(-8+i*4,1.5,-5,0.5,3,7);
 }

 // Oyuncu
 player=new THREE.Group();
 const body=new THREE.Mesh(
  new THREE.BoxGeometry(0.7,1.5,0.5),
  new THREE.MeshStandardMaterial({color:0x26364a})
 );
 body.position.y=0.75;
 player.add(body);
 player.position.set(0,0,8);
 scene.add(player);

 // El feneri
 flashlight=new THREE.SpotLight(0xffffff,4,20,Math.PI/5,0.4);
 flashlight.position.set(0,1.3,0);
 flashlight.target.position.set(0,1,-5);
 player.add(flashlight);
 player.add(flashlight.target);

 // Anahtar
 keyObject=new THREE.Mesh(
  new THREE.BoxGeometry(0.5,0.5,0.5),
  new THREE.MeshStandardMaterial({
   color:0xffdd00,emissive:0x665500
  })
 );
